{
  "name": "monogataritch",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "esbuild src/entry.jsx --bundle --minify --charset=utf8 --format=iife --outfile=app.js --loader:.jsx=jsx --jsx=transform && npm run css",
    "build:dist": "npm run build && node tools/build-dist.mjs",
    "css": "tailwindcss -i src/tw.css -o tailwind.css --minify",
    "dev": "esbuild src/entry.jsx --bundle --charset=utf8 --format=iife --outfile=app.js --loader:.jsx=jsx --jsx=transform --watch",
    "test": "node tools/test-inline-format.mjs && node tools/test-app-mode.mjs",
    "deploy": "npm run build:dist && wrangler pages deploy dist --project-name monogataritch --branch main",
    "verify:prod": "node tools/verify-deploy.mjs",
    "preview": "npm run build:dist && wrangler pages dev dist"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.3",
    "dagre": "^0.8.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "0.23.1",
    "tailwindcss": "^3.4.19",
    "wrangler": "^4.104.0"
  }
}
